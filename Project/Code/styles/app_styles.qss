/* General Styles */
QWidget {
    background-color: #2C3E50;  /* Primary: Dark Grey */
    color: #ECF0F1;            /* Neutral: Very Light Grey */
}

/* Login Page Styles */

/* Logo Label */
QLabel#logoLabel {
    font-size: 24px;
    font-weight: bold;
    color: #ECF0F1;  /* Neutral */
    text-align: center;
}

/* Welcome Label for Login Page */
QLabel#welcomeLabel {
    font-size: 18px;
    font-weight: bold;
    color: #3498DB; /* Accent */
    text-align: center;
}

/* Error Label */
QLabel#errorLabel {
    color: #C0392B; /* Error: Scarlet */
}

/* Input Fields */
QLineEdit#usernameInput,
QLineEdit#passwordInput {
    background-color: #34495E; /* Slightly lighter grey */
    color: #ECF0F1; /* Neutral */
    border: 1px solid #3498DB; /* Accent */
    border-radius: 5px;
    padding: 5px;
}

/* Show Checkbox */
QCheckBox#showUsernameCheckbox,
QCheckBox#showPasswordCheckbox {
    color: #ECF0F1; /* Neutral */
}

/* Forgot Password Button */
QPushButton#forgotPasswordButton {
    color: #ECF0F1; /* Neutral */
    background-color: transparent;
    border: none;
    text-decoration: underline;
}

QPushButton#forgotPasswordButton:hover {
    color: #3498DB; /* Accent */
}

/* User Dashboard Styles */

/* Welcome Label */
QLabel#welcomeLabel {
    font-size: 22px;
    font-weight: bold;
    color: #3498DB; /* Accent */
    text-align: center;
}

/* Sales Overview */
QLabel#salesLabel {
    font-size: 18px;
    font-weight: regular;
    color: white; /* Primary */
    text-align: center;
}

/* Buttons for Both Pages */
QPushButton#viewReportsButton,
QPushButton#manageFieldsButton,
QPushButton#homeButton,
QPushButton#addSalesButton,
QPushButton#settingsButton,
QPushButton#helpButton,
QPushButton#logoutButton,
QPushButton#loginButton {
    background-color: #3498DB; /* Accent */
    color: #ECF0F1;           /* Neutral */
    border: none;
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
    border-radius: 8px;
}

/* Hover and Pressed States for Buttons */
QPushButton#viewReportsButton:hover,
QPushButton#manageFieldsButton:hover,
QPushButton#homeButton:hover,
QPushButton#addSalesButton:hover,
QPushButton#settingsButton:hover,
QPushButton#helpButton:hover,
QPushButton#logoutButton:hover,
QPushButton#loginButton:hover {
    background-color: #5DADE2; /* Lighter Accent */
}

QPushButton#viewReportsButton:pressed,
QPushButton#manageFieldsButton:pressed,
QPushButton#homeButton:pressed,
QPushButton#addSalesButton:pressed,
QPushButton#settingsButton:pressed,
QPushButton#helpButton:pressed,
QPushButton#logoutButton:pressed,
QPushButton#loginButton:pressed {
    background-color: #2980B9; /* Darker Accent */
}
