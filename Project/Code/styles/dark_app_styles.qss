/* General Styles */
QWidget {
    /* A darker base background color */
    background-color: #1A1A1A;
    /* Darker than #2C3E50 */
    color: #ECECEC;
    /* Slightly brighter text for better contrast */
}

/* Login Page Styles */

/* Logo Label */
QLabel#logoLabel {
    font-size: 24px;
    font-weight: bold;
    color: #ECECEC;
    /* Neutral */
    text-align: center;
}

/* Welcome Label for Login Page */
QLabel#welcomeLabel {
    font-size: 18px;
    font-weight: bold;
    color: #3498DB;
    /* Accent */
    text-align: center;
}

/* Error Label */
QLabel#errorLabel {
    color: #C0392B;
    /* Error: Scarlet */
}

/* Input Fields */
QLineEdit#usernameInput,
QLineEdit#passwordInput {
    background-color: #2A2A2A;
    /* Dark grey for inputs */
    color: #ECECEC;
    /* Neutral text */
    border: 1px solid #3498DB;
    /* Accent border */
    border-radius: 5px;
    padding: 5px;
}

/* Show Checkbox */
QCheckBox#showUsernameCheckbox,
QCheckBox#showPasswordCheckbox {
    color: #ECECEC;
    /* Neutral */
}

/* Forgot Password Button */
QPushButton#forgotPasswordButton {
    color: #ECECEC;
    /* Neutral */
    background-color: transparent;
    border: none;
    text-decoration: underline;
}

QPushButton#forgotPasswordButton:hover {
    color: #3498DB;
    /* Accent */
}

/* User Dashboard Styles */

/* Welcome Label */
QLabel#welcomeLabel {
    font-size: 22px;
    font-weight: bold;
    color: #3498DB;
    /* Accent */
    text-align: center;
}

/* Table Widget Styling */
QTableWidget#fieldsTable {
    border: 1px solid #5DADE2;
    /* Accent color */
    background-color: #2A2A2A;
    /* Dark grey */
    color: #ECECEC;
    /* Neutral */
    gridline-color: #5DADE2;
    /* Accent color */
    font-size: 14px;
    /* Adjust as needed */
    font-weight: bold;
    /* Optional */
}

/* Table Headers */
QHeaderView::section {
    background-color: #1A1A1A;
    /* Darker background */
    color: #ECECEC;
    /* Neutral */
    border: 1px solid #5DADE2;
    /* Accent color */
    padding: 5px;
    /* Add some padding for a cleaner look */
    font-size: 14px;
    /* Adjust header text size */
    font-weight: bold;
}

/* Table Cells */
QTableWidget::item {
    background-color: #2A2A2A;
    /* Dark grey for cells */
    color: #ECECEC;
    /* Neutral */
    padding: 5px;
    border: none;
}

/* Selected Table Cell */
QTableWidget::item:selected {
    background-color: #5DADE2;
    /* Accent */
    color: #ECECEC;
    /* Neutral */
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: #1A1A1A;
    /* Match primary dark background */
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #5DADE2;
    /* Accent */
    min-height: 20px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}

/* ComboBox Styling */
QComboBox#fieldTypeDropdown {
    background-color: #2A2A2A;
    /* Dark grey */
    color: #ECECEC;
    /* Neutral */
    border: 1px solid #5DADE2;
    /* Accent */
    padding: 5px;
    border-radius: 5px;
}

QComboBox#fieldTypeDropdown QAbstractItemView {
    background-color: #1A1A1A;
    /* Darker background */
    color: #ECECEC;
    /* Neutral */
    selection-background-color: #5DADE2;
    /* Accent */
    selection-color: #ECECEC;
    /* Neutral */
}

/* Buttons */
QPushButton#reportsButton,
QPushButton#manageFieldsButton,
QPushButton#homeButton,
QPushButton#addSalesButton,
QPushButton#settingsButton,
QPushButton#helpButton,
QPushButton#logoutButton,
QPushButton#loginButton,
QPushButton#addFieldButton {
    background-color: #3498DB;
    color: #ECECEC;
    border: none;
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
    border-radius: 8px;
}

/* Hover and Pressed States for Buttons */
QPushButton#reportsButton:hover,
QPushButton#manageFieldsButton:hover,
QPushButton#homeButton:hover,
QPushButton#addSalesButton:hover,
QPushButton#settingsButton:hover,
QPushButton#helpButton:hover,
QPushButton#logoutButton:hover,
QPushButton#loginButton:hover,
QPushButton#addFieldButton:hover {
    background-color: #5DADE2;
}

QPushButton#reportsButton:pressed,
QPushButton#manageFieldsButton:pressed,
QPushButton#homeButton:pressed,
QPushButton#addSalesButton:pressed,
QPushButton#settingsButton:pressed,
QPushButton#helpButton:pressed,
QPushButton#logoutButton:pressed,
QPushButton#loginButton:pressed,
QPushButton#addFieldButton:pressed {
    background-color: #2980B9;
}

/* Sales Overview Box Styles */
QLabel#dailyGoalLabel,
QLabel#weeklyGoalLabel,
QLabel#weeklySalesLabel,
QLabel#monthlySalesLabel,
QLabel#pendingReportsLabel {
    font-size: 18px;
    font-weight: bold;
    color: #ECECEC;
    /* Neutral */
    background-color: #2A2A2A;
    /* Dark grey box */
    border: 2px solid #3498DB;
    /* Accent */
    border-radius: 8px;
    padding: 10px;
    text-align: center;
}