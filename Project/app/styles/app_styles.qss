/* General Styles */
QWidget {
    background-color: #2C3E50;  /* Primary: Dark Grey */
    color: #ECF0F1;            /* Neutral: Very Light Grey */
}

/* Labels */
QLabel {
    font-size: 16px;
    color: #ECF0F1;
}

QLabel#welcomeLabel, QLabel#dailyGoalLabel, QLabel#weeklyGoalLabel, 
QLabel#weeklySalesLabel, QLabel#monthlySalesLabel, QLabel#pendingReportsLabel {
    font-size: 18px;
    font-weight: bold;         
    background-color: #34495E;  
    border: 2px solid #3498DB;   
    border-radius: 8px;          
    padding: 10px;                
    text-align: center;          
}

QLabel#errorLabel {
    color: #C0392B; /* Error: Scarlet */
}

/* Input Fields */
QLineEdit {
    background-color: #34495E; /* Slightly lighter grey */
    color: #ECF0F1; /* Neutral */
    border: 1px solid #3498DB; /* Accent */
    border-radius: 5px;
    padding: 5px;
}

/* Checkboxes */
QCheckBox {
    color: #ECF0F1;
}

QPushButton {
    background-color: #3498DB;
    color: #ECF0F1;
    border: 2px solid #2980B9;
    font-size: 16px;
    font-weight: bold;
    padding: 10px;
    border-radius: 8px;
    min-width: 120px;
    min-height: 40px;
}

QPushButton:hover {
    background-color: #5DADE2;
    border-color: #1F618D;
}

QPushButton:pressed {
    background-color: #2980B9;
    border-color: #1F4E75;
}

/* Special Buttons */
QPushButton#forgotPasswordButton {
    background-color: transparent;
    border: none;
    text-decoration: underline;
}

QPushButton#forgotPasswordButton:hover {
    color: #3498DB;
}

/* Table Styling */
QTableWidget {
    border: 1px solid #5DADE2;
    background-color: #34495E;
    color: #ECF0F1;
    /* lighting-color: #5DADE2; */
    font-size: 14px;
    font-weight: bold;
}

/* Table Headers */
QHeaderView::section {
    background-color: #2C3E50;
    color: #ECF0F1;
    border: 1px solid #5DADE2;
    padding: 5px;
    font-size: 14px;
    font-weight: bold;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: #2C3E50;
    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #5DADE2;
    min-height: 20px;
}

/* Combobox */
QComboBox {
    background-color: #34495E;
    color: #ECF0F1;
    border: 1px solid #5DADE2;
    padding: 5px;
    border-radius: 5px;
}

QComboBox QAbstractItemView {
    background-color: #2C3E50;
    color: #ECF0F1;
    /* selection-background-color: #5DADE2; */
    color: #ECF0F1;
}

/* Tabs */
QTabWidget {
    background-color: #2C3E50;
    border: 1px solid #3498DB;
}

QTabBar::tab {
    background-color: #2C3E50;
    color: #ECF0F1;
    border: 1px solid #3498DB;
    padding: 10px;
    min-width: 100px;
    text-align: center;
}

QTabBar::tab:selected {
    background-color: #3498DB;
    font-weight: bold;
}

QTabBar::tab:hover {
    background-color: #1F618D;
}

QTabWidget::pane {
    border: none;
    padding: 5px;
}


/* Sales Overview Box Styles */
QLabel#dailyGoalLabel, 
QLabel#weeklyGoalLabel,
QLabel#weeklySalesLabel, 
QLabel#monthlySalesLabel, 
QLabel#pendingReportsLabel {
    font-size: 18px;
    font-weight: bold;         
    color: #ECF0F1;              
    background-color: #34495E;  
    border: 2px solid #3498DB;   
    border-radius: 8px;          
    padding: 10px;               
    text-align: center;          
}

/* Welcome Label */
QLabel#welcomeLabel {
    font-size: 22px;
    font-weight: bold;
    color: #3498DB; /* Accent */
    text-align: center;
}


QPushButton#deleteButton {
    background-color: #E74C3C;
    color: white;
    border: none;
    border-radius: 3px;
    min-width: 30px;  
    max-width: 35px;  
    min-height: 27px; 
    max-height: 27px;
    font-size: 14px;   
    font-weight: bold;
    padding: 0px;
    margin: 0px;
    text-align: center; 
}

QPushButton#deleteButton:hover {
    background-color: #C0392B;
}
